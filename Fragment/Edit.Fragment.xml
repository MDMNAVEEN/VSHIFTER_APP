<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<Dialog showHeader="false" id="id_editclose" class="cl_fragment">
		<VBox class="cl_frag">
			<HBox class="cl_createfragment" justifyContent="Center" alignContent="Center" alignItems="Center">
				<Label text="Edit Planned Order" class="cl_ftext sapUiSmallMarginTop"></Label>
			</HBox>
			<VBox class="sapUiTinyMargin sapUiSmallMarginTop sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiTinyMarginBottom">
				<HBox>
					<VBox>
						<Toolbar class="cl_tool">
							<Label text="Plant" class="sapUiSmallMargin cl_font_txt"/>
							<ToolbarSpacer/>
							<Input width="10rem" height=".2rem" placeholder="Select Plant" required="true" id="id_changepl" value="{tempModel>/0/plant}" editable="false"
							valueHelpRequest="fnPlantFrg" showValueHelp="true" class="cl_input_t sapUiSizeCompact sapUiSmallMargin sapUiMediumMarginTop"/>
						</Toolbar>
						<Toolbar class="cl_tool">
							<Label text="Start Date" class="sapUiSmallMargin cl_font_txt"/>
							<ToolbarSpacer/>
							<DatePicker width="10rem" height=".2rem" id="id_changepl_sdate" value="{tempModel>/0/fromDate}" change="fnvalidatedate" liveChange="fnvalidatedate"
							class="cl_input_t sapUiSizeCompact sapUiSmallMargin sapUiMediumMarginTop" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>
						</Toolbar>
					</VBox>
					<VBox>
						<Toolbar class="cl_tool">
							<Label text="Target Quantity" class="sapUiSmallMargin cl_font_txt"/>
							<ToolbarSpacer/>
							<Input width="10rem" height=".2rem" placeholder="Enter Target Quantity" id="id_changepl_qty" value="{tempModel>/0/qty}"
							class="cl_input_t sapUiSizeCompact sapUiSmallMargin sapUiMediumMarginTop"/>
						</Toolbar>
						<Toolbar class="cl_tool">
							<Label text="End Date" class="sapUiSmallMargin cl_font_txt"/>
							<ToolbarSpacer/>
							<DatePicker width="10rem" height=".2rem" id="id_changepl_edate" value="{tempModel>/0/toDate}" change="fnvalidatedate1" liveChange="fnvalidatedate1"
							class="cl_input_t sapUiSizeCompact sapUiSmallMargin sapUiMediumMarginTop" valueFormat="yyyy-MM-dd" displayFormat="dd.MM.yyyy"/>
						</Toolbar>
					</VBox>
				</HBox>
			</VBox>
			<HBox class="cl_footer">
				<HBox width="30%"></HBox>
				<Button icon="{JM_ImageModel>/path}frag_close.svg" text="Close" press="fnCloseplanchange"
					class="sapUiLargeMarginBegin sapUiSizeCompact increaseFont cl_fragclose"></Button>
				<Button icon="{JM_ImageModel>/path}frag_create.svg" text="Save" press="fnsaveplanchange" class="sapUiSmallMarginBegin sapUiSizeCompact cl_fragcreate01"></Button>
			</HBox>
		</VBox>
	</Dialog>
</core:FragmentDefinition>